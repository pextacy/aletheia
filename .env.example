# Aletheia environment configuration.
# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# Target chain ID. 10143 = Monad testnet (this hackathon). 143 = Monad mainnet.
CHAIN_ID=10143

# JSON-RPC endpoint for the target chain.
RPC_URL=https://testnet-rpc.monad.xyz

# Block explorer base URL, used for links on the proof page and in CLI output.
EXPLORER_URL=https://testnet.monadexplorer.com

# Deployed AletheiaRegistry address. Written by the deploy script to
# deployments/10143.json; mirror it here for bridge and web.
REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Private key of the low-privilege attestor hot wallet, used ONLY by the bridge
# to call attest/attestBatch. Never the owner key. Rotatable via setAttestor.
# Attestor address for this deployment: 0x89da9812e7F12538119cc58E35bFc62270dDDcFD
# (Owner wallet address, key kept offline, never on a server:
#  0xA6b1F84D2fDF9DF0EB4CbA290ADF7e541e16fc04)
ATTESTOR_PRIVATE_KEY=0xINVALID_fill_with_attestor_key

# HMAC secret for GitHub webhook X-Hub-Signature-256 verification.
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=INVALID_fill_with_random_hex

# Read-only GitHub token. Used by web/cli for commit metadata and tree hashes.
GITHUB_TOKEN=ghp_INVALID_fill_with_readonly_token
